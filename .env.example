# Copy to .env and fill in. .env is git-ignored — never commit a real key.
# Each team member creates their own free key at https://console.groq.com/keys
# Stay on the free plan: never add a payment method.

# Imposed generative model, announced by the lecturer (same for every team).
# Fallback openai/gpt-oss-20b ONLY when the lecturer announces it.
PHARMEAZOR_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Retriever used by the API: bm25 | dense
PHARMEAZOR_RETRIEVER=bm25
